{
  "name": "lemon",
  "displayName": "Lemon 🍋",
  "description": "Run a local AI chat server powered by Lemonade Server directly in VS Code",
  "publisher": "lanly-dev",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "LEMON_CHAT",
        "name": "Lemon",
        "description": "Chat with a local AI model powered by Lemonade Server",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Generate a fix for the selected code"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "lemon.startServer",
        "title": "Lemon: Start Server",
        "icon": "$(play)"
      },
      {
        "command": "lemon.stopServer",
        "title": "Lemon: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "lemon.downloadBinary",
        "title": "Lemon: Download/Update Binary"
      },
      {
        "command": "lemon.openChat",
        "title": "Lemon: Open Chat"
      },
      {
        "command": "lemon.openSettings",
        "title": "Lemon: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "lemon.pullModel",
        "title": "Lemon: Pull Model",
        "icon": "$(cloud-download)"
      },
      {
        "command": "lemon.loadModel",
        "title": "Lemon: Load Model",
        "icon": "$(run-above)"
      },
      {
        "command": "lemon.unloadModel",
        "title": "Lemon: Unload Model",
        "icon": "$(run-below)"
      },
      {
        "command": "lemon.removeModel",
        "title": "Lemon: Remove Model",
        "icon": "$(trash)"
      },
      {
        "command": "lemon.selectModel",
        "title": "Lemon: Select Active Model"
      },
      {
        "command": "lemon.refreshServer",
        "title": "Lemon: Refresh Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "lemon.switchToStandalone",
        "title": "Lemon: Switch to Standalone Server"
      },
      {
        "command": "lemon.selectServer",
        "title": "Lemon: Select Server",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "lemon.setMaxLoadedModels",
        "title": "Lemon: Set Max Loaded Models"
      },
      {
        "command": "lemon.openServerUrl",
        "title": "Lemon: Open Server URL",
        "icon": "$(link-external)"
      },
      {
        "command": "lemon.editServerPort",
        "title": "Lemon: Edit Server Port / URL",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "LEMON_SIDEBAR",
          "title": "Lemon",
          "icon": "media/lemon.svg"
        }
      ]
    },
    "views": {
      "LEMON_SIDEBAR": [
        {
          "id": "LEMON_TREEVIEW",
          "name": "Server",
          "icon": "$(server)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lemon.refreshServer",
          "when": "view == LEMON_TREEVIEW",
          "group": "navigation"
        },
        {
          "command": "lemon.pullModel",
          "when": "view == LEMON_TREEVIEW",
          "group": "navigation"
        },
        {
          "command": "lemon.openSettings",
          "when": "view == LEMON_TREEVIEW",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lemon.selectServer",
          "when": "view == LEMON_TREEVIEW && viewItem == LEMON_SERVER_HEADER",
          "group": "inline"
        },
        {
          "command": "lemon.openServerUrl",
          "when": "view == LEMON_TREEVIEW && viewItem == LEMOND_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "lemon.editServerPort",
          "when": "view == LEMON_TREEVIEW && viewItem == LEMOND_SERVER_URL",
          "group": "inline"
        },
        {
          "command": "lemon.startServer",
          "when": "view == LEMON_TREEVIEW && (viewItem == LEMON_SERVER_STOPPED || viewItem == LEMON_SERVER_ERROR) && config.lemon.targetServer == embedded",
          "group": "inline"
        },
        {
          "command": "lemon.stopServer",
          "when": "view == LEMON_TREEVIEW && viewItem == LEMON_SERVER_RUNNING && config.lemon.targetServer == embedded",
          "group": "inline"
        },
        {
          "command": "lemon.loadModel",
          "when": "view == LEMON_TREEVIEW && viewItem == LEMOND_MODEL_AVAILABLE",
          "group": "inline"
        },
        {
          "command": "lemon.unloadModel",
          "when": "view == LEMON_TREEVIEW && (viewItem == LEMOND_MODEL_LOADED || viewItem == LEMOND_LOADED_MODEL)",
          "group": "inline"
        },
        {
          "command": "lemon.removeModel",
          "when": "view == LEMON_TREEVIEW && (viewItem == LEMOND_MODEL_AVAILABLE || viewItem == LEMOND_MODEL_LOADED || viewItem == LEMOND_LOADED_MODEL)",
          "group": "2_remove"
        }
      ]
    },
    "configuration": {
      "title": "Lemon",
      "properties": {
        "lemon.standalonePort": {
          "type": "number",
          "default": 13305,
          "description": "Port for the standalone Lemonade Server"
        },
        "lemon.embeddedPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the embedded lemon server"
        },
        "lemon.chatModel": {
          "type": "string",
          "description": "Last model to use for chat (leave empty to be prompted)"
        },
        "lemon.customServerUrl": {
          "type": "string",
          "default": "",
          "description": "Custom Lemonade Server URL to use when lemon.targetServer is \"custom\" (e.g., http://localhost:13305)"
        },
        "lemon.targetServer": {
          "type": "string",
          "enum": [
            "standalone",
            "embedded",
            "custom"
          ],
          "default": "standalone",
          "description": "Which Lemonade Server to use for chat. \"standalone\" requires an existing system-installed server; \"embedded\" always runs the bundled binary; \"custom\" connects to lemon.customServerUrl."
        },
        "lemon.maxLoadedModels": {
          "type": "number",
          "description": "Maximum number of loaded models (for each type?), Use -1 for unlimited."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "vsce-package": "vsce package",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.x",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
