{
  "name": "lemon",
  "displayName": "lemon 🍋",
  "description": "Run a local AI chat server powered by Lemonade Server directly in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "LEMON_CHAT",
        "name": "Lemonade",
        "description": "Chat with a local AI model powered by Lemonade Server",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Generate a fix for the selected code"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "lemon.startServer",
        "title": "Lemon: Start Server"
      },
      {
        "command": "lemon.stopServer",
        "title": "Lemon: Stop Server"
      },
      {
        "command": "lemon.restartServer",
        "title": "Lemon: Restart Server"
      },
      {
        "command": "lemon.downloadBinary",
        "title": "Lemon: Download/Update Binary"
      },
      {
        "command": "lemon.openChat",
        "title": "Lemon: Open Chat"
      },
      {
        "command": "lemon.pullModel",
        "title": "Lemon: Pull Model",
        "icon": "$(cloud-download)"
      },
      {
        "command": "lemon.loadModel",
        "title": "Lemon: Load Model"
      },
      {
        "command": "lemon.unloadModel",
        "title": "Lemon: Unload Model"
      },
      {
        "command": "lemon.selectModel",
        "title": "Lemon: Select Active Model"
      },
      {
        "command": "lemon.refreshServer",
        "title": "Lemon: Refresh Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "lemon.switchToStandalone",
        "title": "Lemon: Switch to Standalone Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "LEMON_SIDEBAR",
          "title": "Lemon",
          "icon": "media/lemon.svg"
        }
      ]
    },
    "views": {
      "LEMON_SIDEBAR": [
        {
          "id": "lemon.serversView",
          "name": "Servers",
          "icon": "$(server)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lemon.refreshServer",
          "when": "view == lemon.serversView",
          "group": "navigation"
        },
        {
          "command": "lemon.pullModel",
          "when": "view == lemon.serversView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lemon.loadModel",
          "when": "view == lemon.serversView && viewItem == model-unloaded",
          "group": "inline"
        },
        {
          "command": "lemon.unloadModel",
          "when": "view == lemon.serversView && viewItem == model-loaded",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Lemonade",
      "properties": {
        "lemon.serverPort": {
          "type": "number",
          "default": 13305,
          "description": "Port for the standalone Lemonade Server"
        },
        "lemon.embeddedPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the embedded lemon server"
        },
        "lemon.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the server when the extension activates"
        },
        "lemon.useExistingServer": {
          "type": "boolean",
          "default": true,
          "description": "Connect to an existing Lemonade Server if one is already running on the configured port"
        },
        "lemon.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model to use for chat (leave empty to be prompted)"
        },
        "lemon.binaryVersion": {
          "type": "string",
          "default": "latest",
          "description": "Lemonade Server binary version to download (e.g., '11.5.1' or 'latest')"
        },
        "lemon.customServerUrl": {
          "type": "string",
          "default": "",
          "description": "Custom Lemonade Server URL to use for chat (e.g., http://localhost:13305)"
        },
        "lemon.maxLoadedModels": {
          "type": "number",
          "default": 1,
          "description": "Maximum number of models that can be loaded simultaneously for the embedded server. Use -1 for unlimited."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}