{
  "name": "lemon",
  "displayName": "Lemon 🍋",
  "description": "Run a local AI chat server powered by Lemonade Server directly in VS Code",
  "publisher": "lanly-dev",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "LEMON_CHAT",
        "name": "Lemon",
        "description": "Chat with a local AI model powered by Lemonade Server",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Generate a fix for the selected code"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "lemon.startServer",
        "title": "Lemon: Start Server"
      },
      {
        "command": "lemon.stopServer",
        "title": "Lemon: Stop Server"
      },
      {
        "command": "lemon.restartServer",
        "title": "Lemon: Restart Server"
      },
      {
        "command": "lemon.downloadBinary",
        "title": "Lemon: Download/Update Binary"
      },
      {
        "command": "lemon.openChat",
        "title": "Lemon: Open Chat"
      },
      {
        "command": "lemon.openSettings",
        "title": "Lemon: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "lemon.pullModel",
        "title": "Lemon: Pull Model",
        "icon": "$(cloud-download)"
      },
      {
        "command": "lemon.loadModel",
        "title": "Lemon: Load Model"
      },
      {
        "command": "lemon.unloadModel",
        "title": "Lemon: Unload Model"
      },
      {
        "command": "lemon.selectModel",
        "title": "Lemon: Select Active Model"
      },
      {
        "command": "lemon.refreshServer",
        "title": "Lemon: Refresh Server Status",
        "icon": "$(refresh)"
      },
      {
        "command": "lemon.switchToStandalone",
        "title": "Lemon: Switch to Standalone Server"
      },
      {
        "command": "lemon.selectServer",
        "title": "Lemon: Select Server"
      },
      {
        "command": "lemon.setMaxLoadedModels",
        "title": "Lemon: Set Max Loaded Models"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "LEMON_SIDEBAR",
          "title": "Lemon",
          "icon": "media/lemon.svg"
        }
      ]
    },
    "views": {
      "LEMON_SIDEBAR": [
        {
          "id": "lemon.serversView",
          "name": "Servers",
          "icon": "$(server)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lemon.refreshServer",
          "when": "view == lemon.serversView",
          "group": "navigation"
        },
        {
          "command": "lemon.pullModel",
          "when": "view == lemon.serversView",
          "group": "navigation"
        },
        {
          "command": "lemon.openSettings",
          "when": "view == lemon.serversView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lemon.loadModel",
          "when": "view == lemon.serversView && viewItem == model-unloaded",
          "group": "inline"
        },
        {
          "command": "lemon.unloadModel",
          "when": "view == lemon.serversView && viewItem == model-loaded",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Lemon",
      "properties": {
        "lemon.serverPort": {
          "type": "number",
          "default": 13305,
          "description": "Port for the standalone Lemonade Server"
        },
        "lemon.embeddedPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for the embedded lemon server"
        },
        "lemon.chatModel": {
          "type": "string",
          "description": "Last model to use for chat (leave empty to be prompted)"
        },
        "lemon.customServerUrl": {
          "type": "string",
          "default": "",
          "description": "Custom Lemonade Server URL to use when lemon.targetServer is \"custom\" (e.g., http://localhost:13305)"
        },
        "lemon.targetServer": {
          "type": "string",
          "enum": [
            "standalone",
            "embedded",
            "custom"
          ],
          "default": "standalone",
          "description": "Which Lemonade Server to use for chat. \"standalone\" requires an existing system-installed server; \"embedded\" always runs the bundled binary; \"custom\" connects to lemon.customServerUrl."
        },
        "lemon.maxLoadedModels": {
          "type": "number",
          "description": "Maximum number of loaded models, Use -1 for unlimited."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "efix": "eslint . --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.x",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}